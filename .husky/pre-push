#!/bin/sh
# Pre-push hook: 确保发布前使用 CDN 版本而非本地版本

. "$(dirname "$0")/_/husky.sh"

echo "🔍 Checking rtc-agent mode before push..."

# Check if RTC_AGENT_URL is assigned to RTC_AGENT_LOCAL_URL (not just defined)
# Match pattern: const RTC_AGENT_URL = RTC_AGENT_LOCAL_URL
if grep -E "const\s+RTC_AGENT_URL\s*=\s*RTC_AGENT_LOCAL_URL" src/routes/+layout.svelte; then
    echo "❌ Error: Detected local rtc-agent mode in src/routes/+layout.svelte"
    echo ""
    echo "Found: RTC_AGENT_URL = RTC_AGENT_LOCAL_URL"
    echo ""
    echo "Before pushing, you must switch to CDN mode:"
    echo "  const RTC_AGENT_URL = RTC_AGENT_CDN_URL;"
    echo ""
    echo "Or use: pnpm rtc-agent:cdn"
    exit 1
fi

# Check if static/rtc-agent-local files are staged (should not be committed)
if git diff --cached --name-only | grep -q "static/rtc-agent-local/"; then
    echo "❌ Error: static/rtc-agent-local/ files are staged for commit"
    echo ""
    echo "These are local development files and should not be committed."
    echo "Please remove them from staging: git reset HEAD static/rtc-agent-local/"
    exit 1
fi

# Warning if rtc-agent-local directory exists (but not staged)
if [ -d "static/rtc-agent-local" ]; then
    echo "⚠️  Warning: static/rtc-agent-local directory exists"
    echo "This is fine for local development (ensure it's in .gitignore)"
fi

echo "✅ rtc-agent mode check passed (using CDN version)"
exit 0
